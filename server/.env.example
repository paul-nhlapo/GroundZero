# Copy to server/.env and fill in. Never commit the real file.

# Login password for the app, stored as a hash. Create it with:  npm --prefix server run hash-password
APP_PASSWORD_HASH=

# MetaApi API token (https://app.metaapi.cloud/token). Leave empty to run the built-in simulator.
METAAPI_TOKEN=

# Optional: id of an account already added in the MetaApi dashboard.
# Leave empty to link your MT5 account from the app's Settings screen instead.
METAAPI_ACCOUNT_ID=

# Contact address passed to the phone push services with each notification.
VAPID_SUBJECT=mailto:you@example.com

# Where the database file is kept. On a host, point this at a persistent disk.
# DATA_DIR=/data

# PORT=3000
# NODE_ENV=production
